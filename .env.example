# Optional. The game and typed commands work without these values.
# Create your own private ElevenLabs Agent; keep credentials on the server.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Vercel only: Standard Protection makes production public and keeps unique
# deployment URLs private. Paid voice is limited to that private VERCEL_URL.
# Generate your own random secret of at least 32 characters.
GUILD_PUBLIC_ORIGIN=
GUILD_SESSION_SECRET=
GUILD_DEPLOYMENT_PROTECTION=
# Optional settings when exporting an Agent definition.
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=
# Optional local speech tools. Use absolute paths for your installation.
GUILD_PYTHON_PATH=
GUILD_FFMPEG_PATH=
GUILD_VOSK_MODEL_PATH=
